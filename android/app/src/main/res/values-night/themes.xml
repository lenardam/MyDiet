<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MyDiet" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Główny kolor -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <!-- Kolor tekstu/ikon na tle koloru głównego -->
        <item name="colorOnPrimary">@color/white</item>
        <!-- Kolor pomocniczy -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <!-- Kolor tekstu/ikon na tle koloru pomocniczego -->
        <item name="colorOnSecondary">@color/black</item>

        <!--  <item name="android:backgroundTint">@color/colorPrimary</item> -->

        <!-- Kolor tła całej aplikacji -->
        <item name="android:windowBackground">#0ec45a</item>
        <!-- Kolor paska stanu -->
        <item name="android:statusBarColor">#0ec45a</item>
        <!-- Ustawienie ciemnych ikon na pasku stanu -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>