<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MealPresentationFragment">

    <!-- TODO: Update blank fragment layout -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/fr_meal_presentation_iv_meal_image"
                    android:layout_width="120dp"
                    android:layout_height="130dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/sztucce" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/fr_meal_presentation_il_meal_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/fr_meal_presentation_iv_meal_image"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fr_meal_presentation_et_meal_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:hint="Nazwa przepisu"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/fr_meal_presentation_il_meal_protein_amount"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/fr_meal_presentation_il_meal_calories_amount"
                    app:suffixText="g">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fr_meal_presentation_et_meal_protein_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:hint="Białko"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/fr_meal_presentation_il_meal_fat_amount"
                    android:layout_width="128dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintEnd_toStartOf="@+id/fr_meal_presentation_il_meal_carbs_amount"
                    app:layout_constraintStart_toEndOf="@+id/fr_meal_presentation_il_meal_protein_amount"
                    app:layout_constraintTop_toBottomOf="@+id/fr_meal_presentation_il_meal_calories_amount"
                    app:suffixText="g">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fr_meal_presentation_et_meal_fat_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:hint="Tłuszcze"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/fr_meal_presentation_il_meal_carbs_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/fr_meal_presentation_il_meal_fat_amount"
                    app:layout_constraintTop_toBottomOf="@+id/fr_meal_presentation_il_meal_serving_size"
                    app:suffixText="g">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fr_meal_presentation_et_meal_carbs_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:hint="Węglowodany"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/fr_meal_presentation_il_meal_calories_amount"
                    android:layout_width="128dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toEndOf="@+id/fr_meal_presentation_iv_meal_image"
                    app:layout_constraintTop_toBottomOf="@+id/fr_meal_presentation_il_meal_name"
                    app:suffixText="kcal">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fr_meal_presentation_et_meal_calories_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:hint="Kalorie"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/fr_meal_presentation_il_meal_serving_size"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/fr_meal_presentation_il_meal_calories_amount"
                    app:layout_constraintTop_toBottomOf="@+id/fr_meal_presentation_il_meal_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fr_meal_presentation_et_meal_serving_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Porcje"
                        android:inputType="numberDecimal"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/fr_meal_presentation_layout_meal_ingredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fr_meal_presentation_tv_meal_ingredients_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lista składników" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/fr_meal_presentation_rv_meal_ingredients"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/fr_meal_presentation_layout_meal_instruction_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fr_meal_presentation_tv_meal_instruction_steps_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Przepis:" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/fr_meal_presentation_rv_meal_instruction_steps"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>