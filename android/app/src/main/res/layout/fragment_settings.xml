<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="5dp"
    android:paddingRight="5dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:background="@color/colorBackground"
    tools:context=".SettingsFragment">

    <TextView
        android:id="@+id/fr_settings_tv_settings_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/frag_settings_title_text"
        android:textColor="@color/colorOnBackground"
        android:textStyle="bold"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        android:background="@color/lightGreen">

        <TextView
            android:id="@+id/fr_settings_tv_number_of_meals_label"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textSize="16sp"
            android:background="@color/colorBackground"
            android:textColor="@color/colorOnBackground"
            android:text="@string/fragment_settings_reciper_per_day_label_text" />

        <Spinner
            android:id="@+id/fr_settings_spin_number_of_meals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textAlignment="center"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/fr_settings_tv_tags_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textColor="@color/colorOnBackground"
            android:text="@string/fragment_settings_tags_label_text" />

        <Button
            android:id="@+id/fr_settings_btn_add_tag_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/lightGreen"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:text="@string/fragment_settings_add_tag_button_text"
            />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fr_settings_rv_all_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="@drawable/background_white_rounded"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/fr_settings_btn_save_recipes_to_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/lightGreen"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginRight="2dp"
            android:text="@string/fragment_settings_export_button_text" />

        <Button
            android:id="@+id/fr_settings_btn_load_recipes_from_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/lightGreen"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginLeft="2dp"
            android:text="@string/fragment_settings_import_button_text" />
    </LinearLayout>

</LinearLayout>